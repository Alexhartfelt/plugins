{
  // Skill bodies are prose written for a model, not a style guide — lint only
  // for things that actually break rendering or reading.
  "config": {
    "default": true,
    "MD013": false, // line length — descriptions and tables are long on purpose
    "MD010": { "code_blocks": false }, // tabs inside fenced Liquid/JS/CSS snippets are content
    "MD025": false, // a SKILL.md may carry more than one top-level heading (frontmatter title + body)
    "MD028": false, // blank lines inside blockquotes separate procedure steps
    "MD029": false, // step numbers continue across interleaved prose on purpose
    "MD001": false, // reference files use heading levels as visual weight
    "MD024": { "siblings_only": true }, // duplicate headings OK in different sections
    "MD033": false, // inline HTML is used for <details> blocks and tables
    "MD034": false, // bare URLs are fine in reference material
    "MD036": false, // emphasis-as-heading is common in checklists
    "MD041": false, // first line need not be a heading (frontmatter)
    "MD040": false, // fenced code blocks without a language
    "MD060": false  // table column style
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    ".claude/**",
    "plugins/*/docs/wiki/**",
    "plugins/*/skills/*/references/wiki/**",
    "**/CHANGELOG.md"
  ]
}
