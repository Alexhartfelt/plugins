{# color background_color = "#f6f6f6" #}
{# color content_background_color = "#ffffff" #}
{# number content_padding = "20" #}
{# color text_color = "#000000" #}
{# color link_color = "#3498db" #}
{# font content_font = "sans-serif" #}
{# text header_image_url = "https://helloretailcdn.com/images/placeholder_logo.png" #}
{# number header_image_width_px = "300" #}
{% assign header_image_width_restricted = header_image_width_px | times:1 %}
{% assign image_size_limit = 500 %}
{% if header_image_width_restricted >= image_size_limit %}
{% assign header_image_width_restricted = image_size_limit %}
{% endif %}
{# font header_font = "sans-serif" #}
{# color header_background_color = "#ff8300" #}
{# color button_text_color = "#3498db" #}
{# color button_background_color = "#ffffff" #}
{# color button_border_color = "#3498db" #}
{# color old_price_color = "#cccccc" #}
{# color footer_text_color = "#ffffff" #}
{# color footer_background_color = "#ff8300" #}
{# color footer_subtext_color = "#999999" #}
{# multiline footer_content = "Lorem ipsum dolor sit" #}
{# multiline unsubscribe_instructions = "To stop receiving these emails, click the link below:" #}
{# text unsubscribe_link_text = "Unsubscribe" #}
{# color divider_color = "#cccccc" #}
<!doctype html>
<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<title>{{ subject }}</title>
	<style>
			img {
				border: none;
				-ms-interpolation-mode: bicubic;
				max-width: 100%;
			}
			body {
				background-color: {{ background_color }};
				font-family: {{ content_font }};
				-webkit-font-smoothing: antialiased;
				font-size: 14px;
				line-height: 1.4;
				margin: 0;
				padding: 0;
				-ms-text-size-adjust: 100%;
				-webkit-text-size-adjust: 100%;
				width: 100%;
			}
			table {
				border-collapse: separate;
				mso-table-lspace: 0pt;
				mso-table-rspace: 0pt;
				width: 100%;
			}
			table td {
				font-family: {{ content_font }};
				font-size: 14px;
				vertical-align: top;
			}
			.container {
				display: block;
				margin: 0 auto !important;
				max-width: 580px;
				padding: 10px;
				width: 580px;
			}
			.content {
				box-sizing: border-box;
				display: block;
				Margin: 0 auto;
				max-width: 580px;
				padding: 10px;
			}
			.main {
				background-color: {{ content_background_color }};
				border-radius: 3px;
				width: 100%;
			}
			.wrapper {
				box-sizing: border-box;
				padding: {{ content_padding }}px;
			}
			.inner-wrapper, .body {
				width: 100%;
			}
			.footer {
				clear: both;
				padding-top: 10px;
				text-align: center;
				width: 100%;
			}
			.preheader {
				display: none;
			}
			.footer td,
			.footer p,
			.footer span,
			.footer a {
				color: {{ footer_subtext_color }};
				font-size: 12px;
				text-align: center;
			}
			h1, h2, h3, h4 {
				color: {{ text_color }};
				font-family: {{ header_font }};
				font-weight: 400;
				line-height: 1.4;
				margin: 0;
				margin-bottom: 10px;
			}
			h1 {
				font-size: 35px;
				font-weight: 300;
				text-align: center;
			}
			p, ul, ol {
				font-family: {{ content_font }};
				font-size: 14px;
				font-weight: normal;
				margin: 0;
				margin-bottom: 15px;
			}
			p li, ul li, ol li {
				list-style-position: inside;
				margin-left: 5px;
			}
			a {
				color: {{ link_color }};
				text-decoration: underline;
			}
			.btn {
				box-sizing: border-box;
				width: 100%;
			}
			.btn > tbody > tr > td {
				padding-bottom: 15px;
			}
			.btn table {
				width: auto;
			}
			.btn table td {
				background-color: {{ button_background_color }};
				border-radius: 5px;
				text-align: center;
			}
			.btn a {
				background-color: {{ button_background_color }};
				border: solid 1px {{ button_border_color }};
				border-radius: 5px;
				box-sizing: border-box;
				color: {{ button_text_color }};
				cursor: pointer;
				display: inline-block;
				font-size: 14px;
				font-weight: bold;
				margin: 0;
				padding: 12px 25px;
				text-decoration: none;
			}
			.last {
				margin-bottom: 0;
			}
			.first {
				margin-top: 0;
			}
			.align-center {
				text-align: center;
			}
			.align-right {
				text-align: right;
			}
			.align-left {
				text-align: left;
			}
			.clear {
				clear: both;
			}
			.mt0 {
				margin-top: 0;
			}
			.mb0 {
				margin-bottom: 0;
			}
			hr {
				border: 0;
				border-bottom: 1px solid {{ divider_color }};
				margin: 20px 0;
			}
			@media only screen and (max-width: 620px) {
				table[class=body] h1 {
					font-size: 28px !important;
					margin-bottom: 10px !important;
				}
				table[class=body] p,
				table[class=body] ul,
				table[class=body] ol,
				table[class=body] td,
				table[class=body] span,
				table[class=body] a {
					font-size: 16px !important;
				}
				table[class=body] .wrapper,
				table[class=body] .article {
					padding: 10px !important;
				}
				table[class=body] .content {
					padding: 0 !important;
				}
				table[class=body] .container {
					padding: 0 !important;
					width: 100% !important;
				}
				table[class=body] .main {
					border-left-width: 0 !important;
					border-radius: 0 !important;
					border-right-width: 0 !important;
				}
				table[class=body] .btn table {
					width: 100% !important;
				}
				table[class=body] .btn a {
					width: 100% !important;
				}
				table[class=body] .img-responsive {
					height: auto !important;
					max-width: 100% !important;
					width: auto !important;
				}
			}
			@media all {
				.ExternalClass {
					width: 100%;
				}
				.ExternalClass,
				.ExternalClass p,
				.ExternalClass span,
				.ExternalClass font,
				.ExternalClass td,
				.ExternalClass div {
					line-height: 100%;
				}
				.apple-link a {
					color: inherit !important;
					font-family: inherit !important;
					font-size: inherit !important;
					font-weight: inherit !important;
					line-height: inherit !important;
					text-decoration: none !important;
				}
			}
			.mainheader {
				background-color: {{ header_background_color }};
				padding: 20px;
				text-align: center;
			}
			.mainfooter {
				background-color: {{ footer_background_color }};
				padding: 20px;
				text-align: center;
				color: {{ footer_text_color }};
			}
			.mainfooter a {
				color: {{ footer_text_color }};
			}
			.productimage {
				width: 210px;
			}
			.previousprice {
				text-decoration: line-through;
				color: {{ old_price_color }};
			}
		</style>
</head>
<body bgcolor="{{ background_color }}">
<span class="preheader">{{ blocks.preheader }}</span>
<table border="0" cellpadding="0" cellspacing="0" class="body">
	<tr>
		<td>&nbsp;</td>
		<td class="container">
			<div class="content">
				<table bgcolor="{{ content_background_color }}" class="main">
					<!-- HEADER -->
					<tr>
						<td bgcolor="{{ header_background_color }}" class="mainheader">
							<!--[if (gte mso 9)]>
							<table width="100%">
								<tr>
									<td align="center">
										<img width="{{ header_image_width_restricted }}" src="{{ header_image_url }}" alt="">
									</td>
								</tr>
							</table>
							<![endif]-->
							<!--[if !(gte mso 9)]><!-- -->
							<img width="{{ header_image_width_restricted }}" src="{{ header_image_url }}" alt="">
							<!--[endif]---->
						</td>
					</tr>
					<!-- MAIN CONTENT AREA -->
					<tr>
						<td class="wrapper">
							<table border="0" cellpadding="0" cellspacing="0" class="inner-wrapper">
								<tr>
									<td>
										{{ blocks.content }}
									</td>
								</tr>
							</table>
						</td>
					</tr>
					<!-- FOOTER -->
					<tr>
						<td bgcolor="{{ footer_background_color }}" class="mainfooter">
							{{ footer_content }}
						</td>
					</tr>
				</table>
				<!-- SUB FOOTER -->
				<div class="footer">
					<table border="0" cellpadding="0" cellspacing="0">
						<tr>
							<td class="content-block">
								{{ unsubscribe_instructions }}
								<br>
								<a href="{{ unsubscribe_url }}">{{ unsubscribe_link_text }}</a>.
							</td>
						</tr>
					</table>
				</div>
			</div>
		</td>
		<td>&nbsp;</td>
	</tr>
</table>
</body>
</html>
